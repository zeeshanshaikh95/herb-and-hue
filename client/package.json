    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.1",
    "@testing-library/user-event": "19.0.0",
    "autoprefixer": "10.4.20",
    "jsdom": "26.1.0",
    "postcss": "8.5.31",
