# Frontend build-time configuration. Anything prefixed with VITE_ is public.
# Never place JWT_SECRET, MONGODB_URI, admin passwords or Cloudinary secrets here.

# Base URL of the deployed API, e.g. https://herb-and-hue-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000

# Router + asset base path. Use "/" for a root domain, or
# "/your-repository-name/" for GitHub Pages project sites.
VITE_BASE=/

# Canonical public origin of the storefront (used for SEO/Open Graph defaults).
VITE_PUBLIC_SITE_URL=http://localhost:5173
