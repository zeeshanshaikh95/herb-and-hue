# ---------------------------------------------------------------------------
# Herb & Hue — server environment (copy to .env for local development)
# NEVER commit a real .env. In production set these in the API host dashboard.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Required in production.
# Local dev: leave blank to start an ephemeral in-memory MongoDB (dev only).
MONGODB_URI=

# HS256 signing secret. Required in production: 32+ high-entropy characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin session lifetime (jsonwebtoken duration syntax).
JWT_EXPIRES_IN=2h

# Exact frontend origins allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public origins used for canonical links and locally stored dev uploads.
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# First-owner bootstrap. Used ONLY when the database has no admin account.
# Omit both in production after the account exists. Never log or share these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed the development sample catalogue on boot (never seeds fake reviews).
AUTO_SEED=false

# Cloudinary (required in production; all three or none).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=herb-and-hue

# Upload limits for the backend (bytes / file count).
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=6

# Set to 1 behind a trusted reverse proxy (Render, Fly, nginx) so client IPs
# and rate limiting are accurate.
TRUST_PROXY=0

# morgan log format: dev | combined | common | short | tiny
LOG_LEVEL=dev
