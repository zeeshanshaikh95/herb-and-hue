{
  "name": "@herb-and-hue/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node ../scripts/run.mjs tsx watch src/index.ts",
    "build": "node ../scripts/run.mjs tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "node ../scripts/run.mjs tsc --noEmit -p tsconfig.json && node ../scripts/run.mjs tsc --noEmit -p tsconfig.test.json",
    "test": "node ../scripts/run.mjs vitest run",
    "test:watch": "node ../scripts/run.mjs vitest",
    "seed": "node ../scripts/run.mjs tsx src/seed/run.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "compression": "1.8.2",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.7",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.3.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
